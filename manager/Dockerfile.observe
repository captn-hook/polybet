FROM rust:1.94.1-bookworm AS builder

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY services ./services
RUN cargo build --release -p polybet-manager-observe

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/target/release/polybet-manager-observe /usr/local/bin/manager-observe

EXPOSE 8080
CMD ["manager-observe"]
