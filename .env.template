# =========================
# Polybet environment template
# Optional: copy this file to `.env` to override compose defaults.
# =========================

# ---------- Global ----------
# Runtime mode used by all services.
APP_ENV=dev

# Docker network and named volumes (helps portability across machines).
DOCKER_NETWORK_NAME=polybet_net
NATS_VOLUME_NAME=polybet_nats_data

# ---------- PostgreSQL + pgvector ----------
# Core durable storage for accounts, runs, predictions, and embeddings.
POSTGRES_DB=polybet
POSTGRES_USER=polybet
POSTGRES_PASSWORD=polybet_dev_password
POSTGRES_PORT=5432
# Optional admin DSN used by input only for schema migrations (ownership-safe ALTER TABLE).
# Keep DATABASE_URL on least-privilege service roles for runtime reads/writes.
MIGRATION_DATABASE_URL=
# Service-specific DB roles (least privilege by service role).
# These are created automatically on first fresh DB init from ./postgres/init.
INPUT_DB_USER=polybet_input
INPUT_DB_PASSWORD=polybet_input_dev_password
RESOLUTION_DB_USER=polybet_resolution
RESOLUTION_DB_PASSWORD=polybet_resolution_dev_password
OBSERVE_DB_USER=polybet_observe
OBSERVE_DB_PASSWORD=polybet_observe_dev_password
EXPERIMENT_DB_USER=polybet_experiment
EXPERIMENT_DB_PASSWORD=polybet_experiment_dev_password
# Host bind mount for postgres data (survives `docker compose down -v`).
POSTGRES_DATA_PATH=.\data\postgres
# Host path for compressed SQL backups made by postgres_backup sidecar.
POSTGRES_BACKUP_PATH=.\data\backups\postgres
# Backup cadence and retention.
POSTGRES_BACKUP_INTERVAL_SECONDS=3600
POSTGRES_BACKUP_RETENTION_DAYS=14

# ---------- NATS JetStream ----------
# Message backbone for signal and experiment fan-out.
NATS_PORT=4222
# Monitoring endpoint (HTTP) for health and metrics-style inspection.
NATS_MONITOR_PORT=8222

# ---------- Manager-derived services ----------
# Observe service API port published on host (dashboard + status).
MANAGER_PORT=8000
# Input service API port on host.
INPUT_PORT=8001
# Resolution service API port on host.
RESOLUTION_PORT=8002
# Rust log level example: trace, debug, info, warn, error.
MANAGER_LOG_LEVEL=info
# Gamma API base for markets/events discovery.
GAMMA_API_BASE=https://gamma-api.polymarket.com
# Data API base for positions/trades/activity surfaces.
DATA_API_BASE=https://data-api.polymarket.com
# Sync cadence and fetch caps for top market/event ingestion.
SYNC_INTERVAL_SECONDS=120
TOP_MARKETS_LIMIT=100
TOP_EVENTS_LIMIT=100
# Keep only active, not-closed markets ending within this horizon.
MARKET_MAX_MINUTES_TO_END=10
# Hard-fail sync after this many consecutive zero-eligible cycles.
# Set to 0 to disable hard-fail (recommended for local/dev bring-up).
ZERO_ELIGIBLE_FAIL_STREAK=0
# Keep true in development unless explicitly testing live execution.
ENABLE_PAPER_TRADING=true
# Optional override for compose image tags. Defaults to local build tags.
MANAGER_INPUT_IMAGE=polybet-manager-input:local
MANAGER_RESOLUTION_IMAGE=polybet-manager-resolution:local
MANAGER_OBSERVE_IMAGE=polybet-manager-observe:local

# ---------- Signal worker defaults ----------
# Worker role/type. Default is market-implied signal from market.new_question payload.
SIGNAL_KIND=market_implied
# Logical ID for worker identity and provenance.
SIGNAL_ID=signal-market-implied
# Poll interval for pull-based connectors (seconds).
SIGNAL_POLL_INTERVAL_SEC=15
# NATS subject to publish normalized signals.
SIGNAL_OUTPUT_TOPIC=signal.computed.v1
# Source event for signal workers.
MARKET_NEW_QUESTION_TOPIC=market.new_question.v1
# Question signal identity (renamed from pass-through).
QUESTION_SIGNAL_KIND=question
QUESTION_SIGNAL_ID=signal-question
# Outcome-label signal identity.
OUTCOME_LABELS_SIGNAL_KIND=outcome_labels
OUTCOME_LABELS_SIGNAL_ID=signal-outcome-labels
# Market-metadata signal identity.
MARKET_METADATA_SIGNAL_KIND=market_metadata
MARKET_METADATA_SIGNAL_ID=signal-market-metadata
# CLOB microstructure signal identity.
CLOB_MICROSTRUCTURE_SIGNAL_KIND=clob_microstructure
CLOB_MICROSTRUCTURE_SIGNAL_ID=signal-clob-microstructure
# Open-interest signal identity.
OPEN_INTEREST_SIGNAL_KIND=open_interest
OPEN_INTEREST_SIGNAL_ID=signal-open-interest
# Public CLOB base for spread/last-trade fetches.
CLOB_API_BASE=https://clob.polymarket.com
# Optional override for compose image tag. Defaults to local build tag.
SIGNAL_IMAGE=polybet-signal:local

# ---------- Experiment worker defaults ----------
# Path inside container to experiment config file.
# Host folder .\experiment\configs is mounted to /app/configs in compose.
EXPERIMENT_CONFIG_PATH=/app/configs/default.yaml
# Subject experiments consume for signal events.
EXPERIMENT_SIGNAL_TOPIC=signal.computed.v1
# Subject experiments publish prediction proposals to.
PREDICTION_OUTPUT_TOPIC=prediction.proposed.v1
# Optional override for compose image tag. Defaults to local build tag.
EXPERIMENT_IMAGE=polybet-experiment:local

# ---------- Embeddings ----------
# Containers use this URL to access host Ollama.
# On Docker Desktop: host.docker.internal usually works out of the box.
OLLAMA_BASE_URL=http://host.docker.internal:11434

